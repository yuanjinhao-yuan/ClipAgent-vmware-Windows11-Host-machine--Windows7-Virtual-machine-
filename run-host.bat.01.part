@echo off
REM ClipAgent host side (Win11 x64). Auto-reconnect loop.
REM PURE ASCII, NO BOM.
setlocal EnableDelayedExpansion
cd /d "%~dp0"

set "PORT=8080"
set "KEY=mon"
set "OUTDIR=C:\ClipInbox"
set "EXE=release\ClipAgent.exe"

if not exist "%OUTDIR%" mkdir "%OUTDIR%"
if not exist "%EXE%" (
    echo [X] %EXE% not found. Run merge.bat / build.bat first.
    exit /b 1
)

:LOOP
echo [*] %TIME% starting host on port %PORT%
"%EXE%" --listen %PORT% --key %KEY% --outdir "%OUTDIR%" --quiet
echo [!] %TIME% exited rc=%errorlevel%, restart in 2s
timeout /t 2 >nul
goto LOOP